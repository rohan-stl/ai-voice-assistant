# Copy to .env and fill in. Never commit .env.
APP_ENV=staging
# Extra browser origins allowed to call the API (custom storefront domains), comma-separated.
# *.myshopify.com and admin.shopify.com are always allowed.
ALLOWED_ORIGINS=

SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
SHOPIFY_ADMIN_TOKEN=
# true = use the tokens below for the demo store (fine for staging). Use false in production.
ALLOW_SINGLE_STORE_ENV_FALLBACK=true

OPENROUTER_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
