<script src="{{ 'ai-assistant.js' | asset_url }}" defer></script>

<style>
  @import url('https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&display=swap');

  .ai-shopping-assistant {
    --ai-ink: #14162b;
    --ai-muted: #6b6f85;
    --ai-bg: #ffffff;
    --ai-bg-soft: #f3f5ff;
    --ai-accent: #3d5afe;
    --ai-accent-dark: #2541d6;
    --ai-accent-soft: #e7ebff;
    --ai-line: #e3e6f3;

    display: flex;
    align-items: flex-start;
    gap: 16px;
    max-width: 400px;
    padding: 20px;
    border-radius: 20px;
    background: var(--ai-bg);
    border: 1px solid var(--ai-line);
    box-shadow: 0 4px 24px rgba(20, 22, 43, 0.06);
    font-family: 'Inter', system-ui, -apple-system, sans-serif;
    color: var(--ai-ink);
  }

  /* -----------------------------------------------------------
     MIC BUTTON + WAVEFORM
     ----------------------------------------------------------- */

  .ai-assistant-mic-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
  }

  .ai-wave {
    display: flex;
    align-items: center;
    gap: 3px;
    height: 28px;
  }

  .ai-wave span {
    width: 3px;
    border-radius: 2px;
    background: var(--ai-accent);
    opacity: 0.55;
    animation: ai-wave-breathe 1.8s ease-in-out infinite;
  }

  .ai-wave span:nth-child(1) { height: 10px; animation-delay: 0s; }
  .ai-wave span:nth-child(2) { height: 20px; animation-delay: 0.2s; }
  .ai-wave span:nth-child(3) { height: 14px; animation-delay: 0.4s; }

  @keyframes ai-wave-breathe {
    0%, 100% { transform: scaleY(0.6); opacity: 0.4; }
    50% { transform: scaleY(1); opacity: 0.85; }
  }

  .ai-assistant-button {
    position: relative;
    width: 56px;
    height: 56px;
    flex-shrink: 0;
    border: none;
    border-radius: 50%;
    background: linear-gradient(155deg, var(--ai-accent), var(--ai-accent-dark));
    color: #fff;
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 0 0 0 rgba(61, 90, 254, 0.35);
    transition: transform 0.15s ease, box-shadow 0.2s ease;
    animation: ai-mic-pulse 2.6s ease-in-out infinite;
  }

  .ai-assistant-button:hover {
    transform: scale(1.06);
  }

  .ai-assistant-button:active {
    transform: scale(0.96);
  }

  .ai-assistant-button:focus-visible {
    outline: 2px solid var(--ai-accent-dark);
    outline-offset: 3px;
  }

  @keyframes ai-mic-pulse {
    0%, 100% { box-shadow: 0 0 0 0 rgba(61, 90, 254, 0.30); }
    50% { box-shadow: 0 0 0 10px rgba(61, 90, 254, 0); }
  }

  /* -----------------------------------------------------------
     CONTENT
     ----------------------------------------------------------- */

  .ai-assistant-content {
    flex: 1;
    min-width: 0;
  }

  .ai-assistant-eyebrow {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ai-accent);
    margin-bottom: 2px;
  }

  .ai-assistant-title {
    font-family: 'Space Grotesk', sans-serif;
    font-size: 18px;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-bottom: 6px;
  }

  .ai-assistant-status {
    font-size: 13px;
    color: var(--ai-muted);
    line-height: 1.4;
  }

  /* -----------------------------------------------------------
     RESPONSE + PRODUCT CARDS
     (background/spacing set here; JS still controls per-card
     inline styles for images, prices, and the view button)
     ----------------------------------------------------------- */

  .ai-assistant-response {
    display: none;
    margin-top: 14px;
    padding: 14px 16px;
    border-radius: 14px;
    background: var(--ai-bg-soft);
    color: var(--ai-ink);
    font-size: 14px;
    line-height: 1.55;
    text-align: left;
  }

  .ai-assistant-products {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ai-assistant-product-card {
    font-family: 'Inter', system-ui, sans-serif;
    transition: transform 0.15s ease, box-shadow 0.15s ease;
  }

  .ai-assistant-product-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 18px rgba(20, 22, 43, 0.08);
  }

  .ai-assistant-product-card img {
    object-fit: cover;
  }

  @media (max-width: 480px) {
    .ai-shopping-assistant {
      max-width: 100%;
      padding: 16px;
      gap: 12px;
    }

    .ai-assistant-button {
      width: 48px;
      height: 48px;
      font-size: 18px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-assistant-button,
    .ai-wave span {
      animation: none;
    }
  }
</style>

<div
  class="ai-shopping-assistant"
  id="ai-shopping-assistant-{{ block.id }}"
  data-api-base="{{ block.settings.api_base_url }}"
>
  <div class="ai-assistant-mic-wrap">
    <div class="ai-wave" aria-hidden="true">
      <span></span>
      <span></span>
      <span></span>
    </div>

    <button
      type="button"
      class="ai-assistant-button"
      id="ai-assistant-mic-{{ block.id }}"
      aria-label="Start voice search"
    >
      🎤
    </button>
  </div>

  <div class="ai-assistant-content">

    <div class="ai-assistant-eyebrow">Voice Search</div>

    <div class="ai-assistant-title">
      AI Shopping Assistant
    </div>

    <div
      class="ai-assistant-status"
      id="ai-assistant-status-{{ block.id }}"
    >
      Tap the microphone to start
    </div>

    <!-- AI response + product cards -->
    <div
      class="ai-assistant-response"
      id="ai-assistant-response-{{ block.id }}"
    ></div>

  </div>
</div>

{% schema %}
{
  "name": "AI Shopping Assistant",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "api_base_url",
      "label": "AI Backend API Base URL",
      "default": "/apps/ai-assistant",
      "info": "App Proxy path or backend endpoint"

    }
  ]
}
{% endschema %}